# Copiar este archivo como .env y reemplazar todos los valores de ejemplo.
# Nunca subir .env al repositorio.
MSSQL_SA_PASSWORD=Cambiar_Esta_Clave_1!

# Conexiones del operador desde el host.
OPERATOR_USER=sa
OPERATOR_PASSWORD=Cambiar_Esta_Clave_1!
CORP_SERVER=localhost
CORP_PORT=14331
SJ_SERVER=localhost
SJ_PORT=14332
LI_SERVER=localhost
LI_PORT=14333
DB_DATABASE=WideWorldImporters
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Se completan antes de instalar seguridad y replicacion definitivas.
REPL_CORP_PASSWORD=Cambiar_Repl_Corp_1!
REPL_SJ_PASSWORD=Cambiar_Repl_SJ_1!
REPL_LI_PASSWORD=Cambiar_Repl_LI_1!
REPL_RECIBE_CATALOGOS_PASSWORD=Cambiar_Receptor_Catalogos_1!
REPL_RECIBE_SJ_PASSWORD=Cambiar_Receptor_SJ_1!
REPL_RECIBE_LI_PASSWORD=Cambiar_Receptor_LI_1!
MASTER_KEY_PASSWORD=Cambiar_Master_Key_1!
ADMIN_SJ_PASSWORD=Cambiar_Admin_SJ_1!
ADMIN_LIMON_PASSWORD=Cambiar_Admin_Limon_1!
CORPORATIVO_PASSWORD=Cambiar_Corporativo_1!

